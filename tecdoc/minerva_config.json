    "web": {
        "host": "0.0.0.0",
        "port": 5000,
        "debug": false,
        "results_per_page": 50
    },
    "logging": {
        "level": "INFO",
        "file": "./logs/minerva.log",
        "max_size_mb": 50,
        "backup_count": 5,
        "retention_hours": 24
    }
