{
    "database": {
        "path": "./data/minerva.db",
        "backup_enabled": true,
        "backup_path": "./data/backups/"
    },
    "percorsi_base": [
        {
            "nome": "TecDoc",
            "percorso": "E:\\Sviluppo\\Development\\MINERVA\\Files\\TECDOC",
            "tipo": "clienti"
        }
    ],
    "scanner": {
        "filtro_globale_default": {
            "formati_da_leggere": ["*.docx", "*.doc", "*.pdf", "*.xlsx", "*.xls", "*.txt", "*.xml", "*.sql", "*.cmd", "*.ksh", "*.eml", "*.ppt", "*.pptx", "*.mpp"],
            "filtro_data": {
                "usa_giorni_all_indietro": false,
                "giorni_all_indietro": null,
                "data_inizio": null,
                "data_fine": null
            }
        },
        "hash_algorithm": "sha256",
        "max_file_size_mb": 100,
        "utente_scanner": "MINERVA_SCANNER",
        "file_esclusi_regex": [
            "^~",
            "^\\.",
            "^Thumbs\\.db$",
            "^desktop\\.ini$",
            "^ehthumbs\\.db$",
            "\\.tmp$",
            "\\.bak$",
            "\\.lnk$"
        ]
    },
